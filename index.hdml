```html
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رفيق الانضباط | تنظيم الوقت والتركيز</title>
    <!-- استيراد خط تجوال العربي العصري -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <!-- مكتبة Tailwind CSS للتصميم المتجاوب -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- مكتبة Tone.js لتوليد أصوات تنبيه هادئة عند انتهاء الجلسة أو الإنذار -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Tajawal', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            900: '#134e4a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Tajawal', sans-serif;
            background-color: #f8fafc;
        }
        /* تأثير نبض هادئ لشاشة التركيز */
        @keyframes pulse-slow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        .animate-pulse-slow {
            animation: pulse-slow 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        /* تخصيص شريط التمرير */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- شريط التنبيهات العلوية (Toast Message Box) بديلاً عن alert -->
    <div id="toast-container" class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 flex flex-col gap-2 w-11/12 max-w-md pointer-events-none"></div>

    <!-- ===================================================================== -->
    <!-- شاشة الإنذار عند الغياب (Absence Alarm Modal) -->
    <!-- ===================================================================== -->
    <div id="absence-modal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-40 hidden items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border-t-8 border-rose-500 text-center transform transition-all">
            <div class="w-16 h-16 bg-rose-100 text-rose-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-3xl">
                ⚠️
            </div>
            <span class="inline-block px-3 py-1 bg-rose-50 text-rose-700 text-xs font-bold rounded-full mb-2">
                إنذار انضباط: غياب لمدة 24 ساعة
            </span>
            <h2 class="text-2xl font-extrabold text-slate-900 mb-3">أين اختفيت بالأمس؟</h2>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
                لقد مرّ يوم كامل دون أن تسجّل دخولك أو تتابع صلواتك ومهامك. التراجع ليوم واحد مقبول، لكن تركه يتكرر يكسر عادتك. هل كان غيابك بسبب ظرف طارئ أم تشتت؟
            </p>
            <div class="space-y-3">
                <button onclick="dismissAbsenceAlarm('عاد بقوة')" class="w-full py-3.5 px-5 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl shadow-lg shadow-rose-200 transition cursor-pointer">
                    أعتذر، سأعود للالتزام الآن بقوة 💪
                </button>
                <button onclick="dismissAbsenceAlarm('ظرف طارئ')" class="w-full py-3 px-5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl transition cursor-pointer">
                    كان لدي ظرف خارج عن إرادتي
                </button>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- شاشة قفل التركيز الكاملة أثناء الدراسة (Full-Screen Focus Lock Overlay) -->
    <!-- ===================================================================== -->
    <div id="focus-overlay" class="fixed inset-0 bg-slate-950 text-white z-50 hidden flex-col items-center justify-between p-6 sm:p-10 select-none">
        <!-- رأس شاشة التركيز -->
        <div class="w-full max-w-2xl flex items-center justify-between border-b border-slate-800 pb-4">
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></span>
                <span class="text-sm font-bold text-emerald-400">وضع قفل الدراسة نشط</span>
            </div>
            <span id="focus-session-label" class="text-xs sm:text-sm text-slate-400 bg-slate-900 px-3 py-1 rounded-full">
                ممنوع التشتت
            </span>
        </div>

        <!-- منتصف شاشة التركيز: العداد التنازلي والرسالة التحفيزية -->
        <div class="text-center my-auto max-w-xl">
            <p class="text-slate-400 text-sm sm:text-base mb-2">ركّز على هدفك الحالي، الهاتف مغلق عن الملهيات</p>
            <h3 id="focus-task-title" class="text-xl sm:text-2xl font-bold text-teal-300 mb-8">جلسة دراسة عميقة</h3>
            
            <!-- العداد الرقمي الكبير -->
            <div class="relative inline-flex items-center justify-center p-8 sm:p-12 rounded-full bg-slate-900/90 border-4 border-teal-500/40 shadow-[0_0_50px_rgba(20,184,166,0.2)] mb-8">
                <span id="focus-timer-display" class="text-5xl sm:text-7xl font-extrabold tracking-wider font-mono text-white">
                    25:00
                </span>
            </div>

            <!-- اقتباس تحفيزي متجدد -->
            <p id="focus-quote" class="text-slate-300 text-base sm:text-lg italic leading-relaxed animate-pulse-slow">
                "ساعة من التركيز العميق تساوي يوماً كاملاً من العمل المشتت."
            </p>
        </div>

        <!-- أسفل شاشة التركيز: زر الطوارئ مع تأكيد مزدوج -->
        <div class="w-full max-w-md text-center">
            <div id="emergency-step-1">
                <button onclick="requestEmergencyExit()" class="text-xs sm:text-sm text-slate-500 hover:text-rose-400 underline transition py-2 px-4 cursor-pointer">
                    اضغط هنا فقط في حالة الطوارئ القصوى لإنهاء القفل
                </button>
            </div>
            <div id="emergency-step-2" class="hidden bg-slate-900 border border-rose-500/40 rounded-2xl p-4">
                <p class="text-xs sm:text-sm text-rose-300 mb-3 font-medium">
                    هل أنت متأكد من كسر جلسة الدراسة؟ الانسحاب الآن يقلل من نقاط انضباطك.
                </p>
                <div class="flex gap-2 justify-center">
                    <button onclick="cancelEmergencyExit()" class="flex-1 py-2 px-3 bg-teal-600 hover:bg-teal-500 text-white text-xs sm:text-sm font-bold rounded-xl transition cursor-pointer">
                        تراجع وأكمل الدراسة
                    </button>
                    <button onclick="confirmEmergencyExit()" class="py-2 px-3 bg-rose-600/20 hover:bg-rose-600 text-rose-300 hover:text-white text-xs sm:text-sm font-semibold rounded-xl transition cursor-pointer">
                        نعم، خروج طارئ
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- الهيدر الرئيسي للتطبيق -->
    <!-- ===================================================================== -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white flex items-center justify-center text-xl shadow-md">
                    🧭
                </div>
                <div>
                    <h1 class="text-lg sm:text-xl font-extrabold text-slate-900">رفيق الانضباط</h1>
                    <p id="current-date-text" class="text-xs text-slate-500">جاري تحميل التاريخ...</p>
                </div>
            </div>

            <!-- شارة حالة الالتزام وزر محاكاة الغياب -->
            <div class="flex items-center gap-2 sm:gap-3">
                <div class="flex items-center gap-1.5 bg-emerald-50 border border-emerald-200 text-emerald-800 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold">
                    <span>🔥 سلسلة الالتزام:</span>
                    <span id="streak-count">1</span>
                    <span>يوم</span>
                </div>
                <button onclick="simulateDayAbsence()" title="اختبار ما يحدث عند ترك التطبيق ليوم كامل" class="bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1 cursor-pointer">
                    <span>🔔</span>
                    <span class="hidden sm:inline">محاكاة غياب يوم</span>
                    <span class="sm:hidden">إنذار الغياب</span>
                </button>
            </div>
        </div>
    </header>

    <!-- ===================================================================== -->
    <!-- المحتوى الرئيسي -->
    <!-- ===================================================================== -->
    <main class="max-w-5xl mx-auto w-full px-4 sm:px-6 py-6 space-y-6 flex-1">

        <!-- البطاقة الأولى: السؤال عن الحال اليومي + مؤشر الإنجاز العام -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- قسم السؤال عن الحال -->
            <div class="lg:col-span-2 bg-white rounded-3xl p-5 sm:p-6 shadow-sm border border-slate-200/80">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
                        <span>💬</span> كيف تشعر اليوم؟
                    </h2>
                    <span id="mood-badge" class="text-xs font-bold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">
                        لم يتم التحديد بعد
                    </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-500 mb-4">
                    أخبرني بحالتك النفسية والبدنية لأضبط لك نصيحة اليوم وخطة مهامك بما يناسب طاقتك:
                </p>

                <!-- أزرار اختيار الحالة -->
                <div class="grid grid-cols-3 gap-2.5 sm:gap-4 mb-4">
                    <button onclick="selectMood('high')" id="btn-mood-high" class="mood-btn flex flex-col items-center justify-center p-3 sm:p-4 rounded-2xl border-2 border-slate-100 hover:border-teal-400 bg-slate-50/50 transition cursor-pointer">
                        <span class="text-2xl sm:text-3xl mb-1">⚡</span>
                        <span class="text-xs sm:text-sm font-bold text-slate-800">طاقة عالية</span>
                    </button>
                    <button onclick="selectMood('normal')" id="btn-mood-normal" class="mood-btn flex flex-col items-center justify-center p-3 sm:p-4 rounded-2xl border-2 border-slate-100 hover:border-blue-400 bg-slate-50/50 transition cursor-pointer">
                        <span class="text-2xl sm:text-3xl mb-1">🙂</span>
                        <span class="text-xs sm:text-sm font-bold text-slate-800">حالة عادية</span>
                    </button>
                    <button onclick="selectMood('tired')" id="btn-mood-tired" class="mood-btn flex flex-col items-center justify-center p-3 sm:p-4 rounded-2xl border-2 border-slate-100 hover:border-amber-400 bg-slate-50/50 transition cursor-pointer">
                        <span class="text-2xl sm:text-3xl mb-1">🔋</span>
                        <span class="text-xs sm:text-sm font-bold text-slate-800">متعب قليلاً</span>
                    </button>
                </div>

                <!-- الخطة المقترحة بناءً على الحالة -->
                <div id="mood-advice-box" class="bg-brand-50 border border-brand-100 rounded-2xl p-4 text-xs sm:text-sm text-brand-900 leading-relaxed">
                    👋 أهلاً بك! اختر حالتك أعلاه وسأقترح عليك التوازن المثالي بين الدراسة، الصلاة، والرياضة لهذا اليوم.
                </div>
            </div>

            <!-- بطاقة نسبة الإنجاز اليومي -->
            <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-3xl p-5 sm:p-6 shadow-md flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm font-semibold text-slate-300">إنجازك اليومي</span>
                        <span class="text-xl">📊</span>
                    </div>
                    <div class="flex items-baseline gap-2 my-3">
                        <span id="progress-percent" class="text-4xl sm:text-5xl font-extrabold text-teal-400">0%</span>
                        <span id="progress-fraction" class="text-xs text-slate-400">(0 من 0 مهام)</span>
                    </div>
                    <!-- شريط التقدم -->
                    <div class="w-full bg-slate-700 rounded-full h-3 overflow-hidden mb-4">
                        <div id="progress-bar" class="bg-gradient-to-l from-teal-400 to-emerald-500 h-3 rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
                <p id="progress-motivation" class="text-xs text-slate-300 leading-relaxed border-t border-slate-700/80 pt-3">
                    ابدأ بأول صلاة أو مهمة صغيرة لكسر حاجز الكسل!
                </p>
            </div>
        </section>

        <!-- البطاقة الثانية: وضع التركيز وقفل الهاتف للدراسة -->
        <section class="bg-white rounded-3xl p-5 sm:p-6 shadow-sm border border-slate-200/80">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">🔒</span>
                        <h2 class="text-base sm:text-lg font-bold text-slate-900">وضع قفل الدراسة والتركيز العميق</h2>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-500">
                        حدد مدة الدراسة وسيتم قفل واجهة التطبيق بالكامل ومنع التشتت حتى ينتهي المؤقت.
                    </p>
                </div>

                <!-- أدوات ضبط المؤقت وبدء الجلسة -->
                <div class="flex flex-wrap items-center gap-2.5">
                    <!-- أزرار مدد سريعة -->
                    <div class="flex bg-slate-100 p-1 rounded-xl">
                        <button onclick="setStudyMinutes(25)" class="preset-min-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-brand-700 shadow-sm transition cursor-pointer" data-min="25">25 د</button>
                        <button onclick="setStudyMinutes(45)" class="preset-min-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition cursor-pointer" data-min="45">45 د</button>
                        <button onclick="setStudyMinutes(60)" class="preset-min-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition cursor-pointer" data-min="60">60 د</button>
                    </div>

                    <!-- إدخال مدة مخصصة بالدقائق -->
                    <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5">
                        <input type="number" id="custom-minutes" value="25" min="1" max="240" class="w-12 bg-transparent text-center font-bold text-sm text-slate-800 focus:outline-none" aria-label="مدة الدراسة بالدقائق">
                        <span class="text-xs text-slate-500">دقيقة</span>
                    </div>

                    <!-- زر تفعيل القفل -->
                    <button onclick="startFocusLock()" class="flex-1 sm:flex-none bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm px-5 py-2.5 rounded-xl shadow-md shadow-brand-500/20 transition flex items-center justify-center gap-2 cursor-pointer">
                        <span>اقفل وابدأ الدراسة</span>
                        <span>🚀</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- البطاقة الثالثة: المهام اليومية المقسمة (الصلوات، التمارين، الدراسة) -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <!-- العمود 1: الصلوات الخمس -->
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-slate-200/80 flex flex-col">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
                    <div class="flex items-center gap-2">
                        <span class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">🕌</span>
                        <h3 class="font-bold text-slate-900">الصلوات الخمس</h3>
                    </div>
                    <span id="prayer-counter" class="text-xs font-bold bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full">0/5</span>
                </div>
                <div id="prayer-list" class="space-y-2.5 flex-1">
                    <!-- يتم توليد الصلوات الخمس هنا عبر JavaScript -->
                </div>
            </div>

            <!-- العمود 2: التمارين الرياضية -->
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-slate-200/80 flex flex-col">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
                    <div class="flex items-center gap-2">
                        <span class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg">🏃‍♂️</span>
                        <h3 class="font-bold text-slate-900">التمارين الرياضية</h3>
                    </div>
                    <span id="workout-counter" class="text-xs font-bold bg-amber-50 text-amber-700 px-2.5 py-1 rounded-full">0/0</span>
                </div>
                <div id="workout-list" class="space-y-2.5 flex-1 mb-4">
                    <!-- يتم توليد التمارين هنا -->
                </div>
                <!-- إضافة تمرين جديد -->
                <form onsubmit="addTask(event, 'workout')" class="flex gap-2 mt-auto pt-2 border-t border-slate-100">
                    <input type="text" id="input-workout" placeholder="أضف تمريناً رياضياً..." class="flex-1 text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:border-amber-400">
                    <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-3.5 py-2 rounded-xl text-sm transition cursor-pointer">+</button>
                </form>
            </div>

            <!-- العمود 3: المهام الدراسية واليومية -->
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-slate-200/80 flex flex-col">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
                    <div class="flex items-center gap-2">
                        <span class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg">📚</span>
                        <h3 class="font-bold text-slate-900">المهام الدراسية</h3>
                    </div>
                    <span id="study-counter" class="text-xs font-bold bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-full">0/0</span>
                </div>
                <div id="study-list" class="space-y-2.5 flex-1 mb-4">
                    <!-- يتم توليد المهام الدراسية هنا -->
                </div>
                <!-- إضافة مهمة دراسية جديدة -->
                <form onsubmit="addTask(event, 'study')" class="flex gap-2 mt-auto pt-2 border-t border-slate-100">
                    <input type="text" id="input-study" placeholder="أضف مهمة دراسية..." class="flex-1 text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:border-indigo-400">
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-3.5 py-2 rounded-xl text-sm transition cursor-pointer">+</button>
                </form>
            </div>

        </section>
    </main>

    <!-- تذييل الصفحة -->
    <footer class="max-w-5xl mx-auto w-full px-4 sm:px-6 py-4 text-center text-xs text-slate-400 flex flex-wrap items-center justify-between gap-2 border-t border-slate-200/60 mt-6">
        <span>يتم حفظ تقدمك تلقائياً داخل متصفحك</span>
        <button onclick="resetTodayData()" class="text-slate-400 hover:text-rose-500 underline transition cursor-pointer">
            إعادة ضبط مهام اليوم
        </button>
    </footer>

    <!-- ===================================================================== -->
    <!-- المنطق البرمجي للتطبيق (JavaScript) -->
    <!-- ===================================================================== -->
    <script>
        // مفتاح التخزين المحلي في المتصفح
        const STORAGE_KEY = 'rafeeq_indibat_data_v1';

        // البيانات الافتراضية لليوم
        const defaultData = {
            lastVisitDate: new Date().toDateString(),
            streak: 1,
            mood: null,
            prayers: [
                { id: 'p1', title: 'صلاة الفجر', done: false },
                { id: 'p2', title: 'صلاة الظهر', done: false },
                { id: 'p3', title: 'صلاة العصر', done: false },
                { id: 'p4', title: 'صلاة المغرب', done: false },
                { id: 'p5', title: 'صلاة العشاء', done: false }
            ],
            workouts: [
                { id: 'w1', title: 'إحماء وتمدد لمدة 10 دقائق', done: false },
                { id: 'w2', title: 'مشي سريع أو تمرين مقاومة 20 دقيقة', done: false }
            ],
            studies: [
                { id: 's1', title: 'مراجعة الدرس الأساسي (جلسة تركيز)', done: false },
                { id: 's2', title: 'حل تمارين تطبيقية وتلخيص الأفكار', done: false }
            ]
        };

        let appState = loadState();
        let focusInterval = null;
        let remainingSeconds = 0;

        // رسائل تحفيزية تظهر أثناء قفل الدراسة
        const focusQuotes = [
            "ساعة من التركيز العميق تساوي يوماً كاملاً من العمل المشتت.",
            "أنت الآن تبني مستقبلك بينما يضيع الآخرون وقتهم في التصفح.",
            "الهاتف لن يهرب، لكن وقتك الثمين يمضي. استمر!",
            "الانضباط هو أن تفعل ما يجب فعله حتى لو لم تكن لديك الرغبة.",
            "اقتربت من إنهاء جلستك بنجاح، حافظ على ثباتك."
        ];

        // تحميل البيانات من localStorage والتحقق من الغياب
        function loadState() {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                if (!saved) {
                    saveState(defaultData);
                    return JSON.parse(JSON.stringify(defaultData));
                }
                const parsed = JSON.parse(saved);
                checkAbsenceLogic(parsed);
                return parsed;
            } catch (e) {
                console.error("خطأ في قراءة البيانات:", e);
                return JSON.parse(JSON.stringify(defaultData));
            }
        }

        // حفظ البيانات في localStorage
        function saveState(stateToSave = appState) {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(stateToSave));
            } catch (e) {
                console.error("خطأ في حفظ البيانات:", e);
            }
        }

        // التحقق مما إذا مرّ أكثر من يوم على آخر زيارة
        function checkAbsenceLogic(state) {
            const today = new Date();
            const lastVisit = new Date(state.lastVisitDate);
            const diffTime = Math.abs(today.setHours(0,0,0,0) - lastVisit.setHours(0,0,0,0));
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays > 1) {
                // المستخدم غاب يوماً كاملاً أو أكثر
                state.streak = 0;
                setTimeout(() => {
                    triggerAbsenceAlarm();
                }, 600);
            } else if (diffDays === 1) {
                // دخول متتالي ليوم جديد
                state.streak = (state.streak || 0) + 1;
                state.lastVisitDate = new Date().toDateString();
                // تصفير حالة الإنجاز لليوم الجديد مع إبقاء المهام
                state.prayers.forEach(p => p.done = false);
                state.workouts.forEach(w => w.done = false);
                state.studies.forEach(s => s.done = false);
                state.mood = null;
                saveState(state);
            }
        }

        // تشغيل نغمة تنبيه لطيفة باستخدام Tone.js
        async function playAlertSound(type = 'success') {
            try {
                await Tone.start();
                const synth = new Tone.Synth().toDestination();
                if (type === 'alarm') {
                    synth.triggerAttackRelease("A4", "8n");
                    setTimeout(() => synth.triggerAttackRelease("E4", "4n"), 200);
                } else {
                    synth.triggerAttackRelease("C5", "8n");
                    setTimeout(() => synth.triggerAttackRelease("G5", "4n"), 180);
                }
            } catch (e) {
                // تجاهل في حال حظر المتصفح للصوت التلقائي
            }
        }

        // عرض رسالة إشعار أنيقة (Toast)
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const colors = {
                info: 'bg-slate-800 text-white border-slate-700',
                success: 'bg-emerald-600 text-white border-emerald-500',
                warning: 'bg-rose-600 text-white border-rose-500'
            };
            toast.className = `${colors[type] || colors.info} px-4 py-3 rounded-2xl shadow-xl border text-xs sm:text-sm font-bold text-center transform transition-all duration-300 opacity-0 translate-y-2`;
            toast.textContent = message;
            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('opacity-0', 'translate-y-2');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', '-translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        }

        // =====================================================================
        // 1. قسم السؤال عن الحال اليومي
        // =====================================================================
        function selectMood(moodKey) {
            appState.mood = moodKey;
            saveState();
            renderMoodSection();
            showToast("تم تحديث خطة يومك بناءً على طاقتك الحالية ✨", "success");
        }

        function renderMoodSection() {
            const adviceBox = document.getElementById('mood-advice-box');
            const moodBadge = document.getElementById('mood-badge');
            document.querySelectorAll('.mood-btn').forEach(btn => {
                btn.classList.remove('border-teal-500', 'bg-teal-50/70', 'border-blue-500', 'bg-blue-50/70', 'border-amber-500', 'bg-amber-50/70');
            });

            if (appState.mood === 'high') {
                document.getElementById('btn-mood-high').classList.add('border-teal-500', 'bg-teal-50/70');
                moodBadge.textContent = "طاقة عالية ⚡";
                moodBadge.className = "text-xs font-bold px-2.5 py-1 rounded-full bg-teal-100 text-teal-800";
                adviceBox.innerHTML = `<strong>خطة الطاقة العالية:</strong> رائع! استثمر هذا النشاط في أصعب مادة دراسية لديك الآن عبر جلسة تركيز لمدة <strong>45 دقيقة</strong>، ولا تنسَ إتمام تمرينك الرياضي الكامل اليوم.`;
            } else if (appState.mood === 'normal') {
                document.getElementById('btn-mood-normal').classList.add('border-blue-500', 'bg-blue-50/70');
                moodBadge.textContent = "حالة عادية 🙂";
                moodBadge.className = "text-xs font-bold px-2.5 py-1 rounded-full bg-blue-100 text-blue-800";
                adviceBox.innerHTML = `<strong>خطة التوازن الهادئ:</strong> يوم مثالي للثبات. حافظ على الصلوات في وقتها، وقسّم دراستك إلى جلستين قصيرتين (<strong>25 دقيقة</strong> لكل جلسة) مع استراحة قصيرة بينهما.`;
            } else if (appState.mood === 'tired') {
                document.getElementById('btn-mood-tired').classList.add('border-amber-500', 'bg-amber-50/70');
                moodBadge.textContent = "متعب قليلاً 🔋";
                moodBadge.className = "text-xs font-bold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800";
                adviceBox.innerHTML = `<strong>خطة التعافي والحد الأدنى:</strong> لا تضغط على نفسك بقسوة اليوم. اكتفِ بالمشي الخفيف أو التمدد، وادرس لمدة <strong>15 إلى 20 دقيقة</strong> فقط للمراجعة الخفيفة حتى تحافظ على سلسلة التزامك دون إرهاق.`;
            }
        }

        // =====================================================================
        // 2. نظام الإنذار عند الغياب
        // =====================================================================
        function triggerAbsenceAlarm() {
            const modal = document.getElementById('absence-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            playAlertSound('alarm');
        }

        function simulateDayAbsence() {
            triggerAbsenceAlarm();
        }

        function dismissAbsenceAlarm(reason) {
            const modal = document.getElementById('absence-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            appState.lastVisitDate = new Date().toDateString();
            if (appState.streak === 0) appState.streak = 1;
            saveState();
            updateHeaderStats();
            showToast(`تم تسجيل عودتك (${reason}). لنبدأ صفحة جديدة اليوم!`, "success");
        }

        // =====================================================================
        // 3. إدارة المهام (الصلوات، التمارين، الدراسة)
        // =====================================================================
        function renderAllLists() {
            renderCategoryList('prayers', 'prayer-list', 'prayer-counter', 'emerald', false);
            renderCategoryList('workouts', 'workout-list', 'workout-counter', 'amber', true);
            renderCategoryList('studies', 'study-list', 'study-counter', 'indigo', true);
            updateProgressSummary();
        }

        function renderCategoryList(categoryKey, containerId, counterId, colorName, allowDelete) {
            const container = document.getElementById(containerId);
            const counter = document.getElementById(counterId);
            const items = appState[categoryKey];

            const doneCount = items.filter(i => i.done).length;
            counter.textContent = `${doneCount}/${items.length}`;

            if (items.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">لا توجد عناصر حالياً. أضف هدفك الأول!</p>`;
                return;
            }

            container.innerHTML = items.map(item => `
                <div class="group flex items-center justify-between p-3 rounded-2xl border transition ${item.done ? 'bg-slate-50 border-slate-100 opacity-75' : 'bg-white border-slate-200/80 hover:border-' + colorName + '-300'}">
                    <label class="flex items-center gap-3 cursor-pointer flex-1 select-none">
                        <input type="checkbox" ${item.done ? 'checked' : ''} onchange="toggleTask('${categoryKey}', '${item.id}')" class="w-5 h-5 rounded-lg accent-teal-600 cursor-pointer">
                        <span class="text-xs sm:text-sm font-medium ${item.done ? 'line-through text-slate-400' : 'text-slate-800'}">
                            ${escapeHTML(item.title)}
                        </span>
                    </label>
                    ${allowDelete ? `
                        <button onclick="deleteTask('${categoryKey}', '${item.id}')" title="حذف" class="text-slate-300 hover:text-rose-500 text-xs px-1.5 py-1 transition cursor-pointer">
                            ✕
                        </button>
                    ` : ''}
                </div>
            `).join('');
        }

        function toggleTask(categoryKey, id) {
            const item = appState[categoryKey].find(i => i.id === id);
            if (item) {
                item.done = !item.done;
                saveState();
                renderAllLists();
                if (item.done) {
                    playAlertSound('success');
                }
            }
        }

        function addTask(event, type) {
            event.preventDefault();
            const inputId = type === 'workout' ? 'input-workout' : 'input-study';
            const categoryKey = type === 'workout' ? 'workouts' : 'studies';
            const input = document.getElementById(inputId);
            const text = input.value.trim();

            if (!text) return;

            appState[categoryKey].push({
                id: type + '_' + Date.now(),
                title: text,
                done: false
            });

            input.value = '';
            saveState();
            renderAllLists();
            showToast("تمت إضافة المهمة بنجاح", "info");
        }

        function deleteTask(categoryKey, id) {
            appState[categoryKey] = appState[categoryKey].filter(i => i.id !== id);
            saveState();
            renderAllLists();
        }

        function updateProgressSummary() {
            const allTasks = [
                ...appState.prayers,
                ...appState.workouts,
                ...appState.studies
            ];
            const total = allTasks.length;
            const completed = allTasks.filter(t => t.done).length;
            const percent = total === 0 ? 0 : Math.round((completed / total) * 100);

            document.getElementById('progress-percent').textContent = `${percent}%`;
            document.getElementById('progress-fraction').textContent = `(${completed} من ${total} مهام)`;
            document.getElementById('progress-bar').style.width = `${percent}%`;

            const motivationEl = document.getElementById('progress-motivation');
            if (percent === 0) {
                motivationEl.textContent = "ابدأ بأول صلاة أو مهمة صغيرة لكسر حاجز الكسل!";
            } else if (percent < 50) {
                motivationEl.textContent = "بداية طيبة! استمر خطوة بخطوة نحو إتمام يومك.";
            } else if (percent < 100) {
                motivationEl.textContent = "أداء رائع! لقد تجاوزت نصف الطريق، بقي القليل.";
            } else {
                motivationEl.textContent = "ما شاء الله! أنجزت 100% من خطة يومك بانضباط تام 🏆";
            }
        }

        // =====================================================================
        // 4. وضع قفل التركيز والدراسة
        // =====================================================================
        function setStudyMinutes(mins) {
            document.getElementById('custom-minutes').value = mins;
            document.querySelectorAll('.preset-min-btn').forEach(btn => {
                if (parseInt(btn.dataset.min) === mins) {
                    btn.className = "preset-min-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-brand-700 shadow-sm transition cursor-pointer";
                } else {
                    btn.className = "preset-min-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition cursor-pointer";
                }
            });
        }

        function startFocusLock() {
            const minsInput = parseInt(document.getElementById('custom-minutes').value);
            if (isNaN(minsInput) || minsInput < 1 || minsInput > 240) {
                showToast("يرجى اختيار مدة صحيحة بين 1 و 240 دقيقة", "warning");
                return;
            }

            // البحث عن أول مهمة دراسية غير منجزة لعرضها كهدف للجلسة
            const nextStudyTask = appState.studies.find(s => !s.done);
            document.getElementById('focus-task-title').textContent = nextStudyTask ? nextStudyTask.title : "جلسة دراسة وتركيز عميق";

            remainingSeconds = minsInput * 60;
            updateTimerDisplay();

            // إعادة ضبط أزرار الطوارئ
            document.getElementById('emergency-step-1').classList.remove('hidden');
            document.getElementById('emergency-step-2').classList.add('hidden');

            // إظهار شاشة القفل الكاملة
            const overlay = document.getElementById('focus-overlay');
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');

            // محاولة تفعيل وضع ملء الشاشة في المتصفح لزيادة التركيز
            try {
                if (document.documentElement.requestFullscreen) {
                    document.documentElement.requestFullscreen().catch(() => {});
                }
            } catch (e) {}

            let quoteIndex = 0;
            clearInterval(focusInterval);
            focusInterval = setInterval(() => {
                remainingSeconds--;
                updateTimerDisplay();

                // تغيير الاقتباس التحفيزي كل 30 ثانية
                if (remainingSeconds % 30 === 0 && remainingSeconds > 0) {
                    quoteIndex = (quoteIndex + 1) % focusQuotes.length;
                    document.getElementById('focus-quote').textContent = `"${focusQuotes[quoteIndex]}"`;
                }

                if (remainingSeconds <= 0) {
                    completeFocusSession();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const mins = Math.floor(remainingSeconds / 60);
            const secs = remainingSeconds % 60;
            const formatted = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            document.getElementById('focus-timer-display').textContent = formatted;
        }

        function completeFocusSession() {
            clearInterval(focusInterval);
            closeFocusOverlay();
            playAlertSound('success');
            showToast("أحسنت! أتممت جلسة الدراسة بنجاح وانضباط 🎉", "success");
        }

        function requestEmergencyExit() {
            document.getElementById('emergency-step-1').classList.add('hidden');
            document.getElementById('emergency-step-2').classList.remove('hidden');
        }

        function cancelEmergencyExit() {
            document.getElementById('emergency-step-2').classList.add('hidden');
            document.getElementById('emergency-step-1').classList.remove('hidden');
        }

        function confirmEmergencyExit() {
            clearInterval(focusInterval);
            closeFocusOverlay();
            showToast("تم إيقاف جلسة الدراسة مبكراً. حاول إكمالها لاحقاً!", "warning");
        }

        function closeFocusOverlay() {
            const overlay = document.getElementById('focus-overlay');
            overlay.classList.add('hidden');
            overlay.classList.remove('flex');
            try {
                if (document.fullscreenElement && document.exitFullscreen) {
                    document.exitFullscreen().catch(() => {});
                }
            } catch (e) {}
        }

        // =====================================================================
        // أدوات مساعدة وتهيئة الصفحة
        // =====================================================================
        function updateHeaderStats() {
            document.getElementById('streak-count').textContent = appState.streak;
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('current-date-text').textContent = new Date().toLocaleDateString('ar-SA', options);
        }

        function resetTodayData() {
            appState = JSON.parse(JSON.stringify(defaultData));
            appState.lastVisitDate = new Date().toDateString();
            saveState();
            renderMoodSection();
            renderAllLists();
            updateHeaderStats();
            showToast("تمت إعادة ضبط مهام اليوم", "info");
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, tag => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                "'": '&#39;',
                '"': '&quot;'
            }[tag]));
        }

        // تشغيل التطبيق عند اكتمال تحميل الصفحة
        window.addEventListener('DOMContentLoaded', () => {
            updateHeaderStats();
            renderMoodSection();
            renderAllLists();
        });
    </script>
</body>
</html>
```